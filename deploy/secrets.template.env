# Umami / site secrets — COPY values into the VPS, JANGAN commit file ini.
# File ini hanya templat. Isi dengan password random dari password manager.

# Umami (docker compose di /opt/umami/docker-compose.yml)
# dibuat dengan: openssl rand -base64 24
CHANGE_ME_DB=                          # POSTGRES_PASSWORD + DATABASE_URL
CHANGE_ME_SECRET=                      # APP_SECRET

# Let's Encrypt — email untuk Let's Encrypt / expiry alert
CHANGE_ME_EMAIL=your@email.com